# Copy to .env and fill in. Never commit .env.

# Gemini (Google AI Studio) — used for embeddings. Free tier.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Answering LLM (OpenAI-compatible; Groq by default). Free tier.
# Get one at https://console.groq.com/keys
LLM_API_KEY=
ATARAG_LLM_BASE_URL=https://api.groq.com/openai/v1
ATARAG_LLM_MODEL=llama-3.3-70b-versatile

# Postgres + pgvector (Neon). Must include ?sslmode=require
DATABASE_URL=

# Optional — LangFuse observability. Traces every answer when set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional overrides (defaults shown)
# ATARAG_CORS_ORIGINS=["https://your-frontend.example.com"]
# ATARAG_TOP_K=10
# ATARAG_MIN_SIMILARITY=0.60          # confidence gate: below this, "not found"

# Answer cache — reuse a stored answer for a repeat or paraphrase, no LLM call.
# ATARAG_QA_CACHE_SIMILARITY=0.90     # how close a paraphrase must be to reuse
# ATARAG_QA_CACHE_MAX_AGE_DAYS=30     # regenerate at least this often (freshness)

# Fallback answering models (Gemini), tried in order when the primary is spent.
# ATARAG_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.0-flash-lite,gemini-flash-latest,gemini-2.0-flash

# Indexing: stop after this many chunks/run so live queries keep embedding quota.
# ATARAG_EMBED_CHUNKS_PER_RUN=850
